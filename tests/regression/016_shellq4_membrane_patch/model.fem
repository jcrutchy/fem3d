# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
Units=SI (N, m, Pa)

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 2, 0, 0
3, 2, 1, 0
4, 0, 1, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, 0.3, -

[PROPERTIES]
# id, type, material, thickness
1, shellq4, 1, 0.05

[ELEMENTS]
# id, type, node1, node2, node3, node4, property
1, shellq4, 1, 2, 3, 4, 1

[FREEDOMCASE default]
# node, dof, value -- fixed edge (1,4) fully clamped; loaded edge (2,3)
# has x prescribed to a uniform strainX=0.001 constant-strain state and
# y pinned to zero, but z/rx/ry/rz left FREE (no entry here) to give
# the solver a genuine, if trivial, system to solve rather than an
# all-constrained one. Membrane, bending, and drilling are fully
# decoupled in this element by construction (see fem_elements.pas'
# QuadShellStiffnessLocal), so those free dof must solve to exactly
# zero and must not affect the membrane reaction -- both independently
# checked below, and cross-checked against
# tests/patch_test/run_patch_test.lpr's "Case Q" (same E, nu,
# thickness, geometry, strainX).
1, x, 0
1, y, 0
1, z, 0
1, rx, 0
1, ry, 0
1, rz, 0
2, x, 0.002
2, y, 0
3, x, 0.002
3, y, 0
4, x, 0
4, y, 0
4, z, 0
4, rx, 0
4, ry, 0
4, rz, 0

[LOADCASE default]
# node, dof, value -- none; this is a pure prescribed-displacement case

[SOLVERPARAMS]
Tolerance=1E-9
