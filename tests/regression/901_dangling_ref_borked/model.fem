# FreePascal FEM Suite - native model format
[HEADER]

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 1, 0, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, -, -

[PROPERTIES]
# id, type, material, area[, Iy, Iz, J]
1, truss, 1, 0.01

[ELEMENTS]
# id, type, node1, node2, property[, refX, refY, refZ]
1, truss, 1, 99, 1

[FREEDOMCASE default]
# node, dof, value
1, x, 0

[LOADCASE default]
# node, dof, value

[SOLVERPARAMS]
Tolerance=1E-9
