# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
Units=SI (N, m, Pa, rad)

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 2, 0, 0
3, 1, 1, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, -, -

[PROPERTIES]
1, truss, 1, 0.0001

[ELEMENTS]
1, truss, 1, 3, 1
2, truss, 2, 3, 1

[FREEDOMCASE default]
1, x, 0
1, y, 0
1, z, 0
2, x, 0
2, y, 0
2, z, 0
3, z, 0

[LOADCASE default]
3, y, -1000

[SOLVERPARAMS]
Tolerance=1E-9
Verbose=0
