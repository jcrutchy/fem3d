# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
Units=SI (N, m, Pa)

[NODES]
# id, x, y, z -- 2x1 rectangle, corners 1-4, midsides 5-8
# (5=mid 1-2, 6=mid 2-3, 7=mid 3-4, 8=mid 4-1), same geometry as
# tests/regression/016_shellq4_membrane_patch
1, 0, 0, 0
2, 2, 0, 0
3, 2, 1, 0
4, 0, 1, 0
5, 1, 0, 0
6, 2, 0.5, 0
7, 1, 1, 0
8, 0, 0.5, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, 0.3, -

[PROPERTIES]
# id, type, material, thickness
1, shellq8, 1, 0.05

[ELEMENTS]
# id, type, node1..node8, property
1, shellq8, 1, 2, 3, 4, 5, 6, 7, 8, 1

[FREEDOMCASE default]
# node, dof, value -- same constrained-width uniaxial strainX=0.001
# state as 016_shellq4_membrane_patch, extended to the 4 extra midside
# nodes: prescribe u=strainX*x, v=0 at every node (exact for this
# field, per the isoparametric linear-field-reproduction argument used
# throughout run_q8_*_test.lpr); clamped edge (x=0: nodes 1,4,8) fully
# fixed; loaded edge (x=2: nodes 2,3,6) and the two horizontal-edge
# midsides (5,7) get u/v prescribed with w/rx/ry/rz left FREE, same as
# the Q4 case's loaded-edge nodes -- membrane/bending/drilling are
# decoupled by construction (see QuadShellStiffnessQ8Local), so these
# must solve to exactly zero.
1, x, 0
1, y, 0
1, z, 0
1, rx, 0
1, ry, 0
1, rz, 0
2, x, 0.002
2, y, 0
3, x, 0.002
3, y, 0
4, x, 0
4, y, 0
4, z, 0
4, rx, 0
4, ry, 0
4, rz, 0
5, x, 0.001
5, y, 0
6, x, 0.002
6, y, 0
7, x, 0.001
7, y, 0
8, x, 0
8, y, 0
8, z, 0
8, rx, 0
8, ry, 0
8, rz, 0

[LOADCASE default]
# node, dof, value -- none; pure prescribed-displacement case

[SOLVERPARAMS]
Tolerance=1E-9
