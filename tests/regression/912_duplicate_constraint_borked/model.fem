# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
[NODES]
1, 0, 0, 0
2, 1, 0, 0

[MATERIALS]
1, 200000000000, 0.3, -

[PROPERTIES]
1, truss, 1, 0.001

[ELEMENTS]
1, truss, 1, 2, 1

[FREEDOMCASE default]
# node 1's x dof is constrained twice, with two different values
1, x, 0
1, y, 0
1, z, 0
1, x, 0.005

[LOADCASE default]
2, x, 1000
