# FreePascal FEM Suite - native model format
[HEADER]

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 1.5, 0, 0
3, 3, 0, 0

[MATERIALS]
# id, E, nu, rho
1, 210000000000, -, 7850

[PROPERTIES]
# id, type, material, area[, Iy, Iz, J]
1, truss, 1, 0.0008

[ELEMENTS]
# id, type, node1, node2, property[, refX, refY, refZ]
1, truss, 1, 2, 1
2, truss, 2, 3, 1

[FREEDOMCASE default]
# node, dof, value
1, x, 0
1, y, 0
1, z, 0
2, y, 0
2, z, 0
3, y, 0
3, z, 0

[LOADCASE default]
# node, dof, value

[SOLVERPARAMS]
Tolerance=1E-9
