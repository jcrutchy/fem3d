# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
Units=SI (N, m, Pa)

[MATERIALS]
1, 200000000000, 0.3, -

[NODES]
# id, x, y, z -- corners 1-4, then midsides 5 (1-2), 6 (2-3), 7 (3-4), 8 (4-1) at exact edge midpoints
1, 0, 0, 0
2, 2, 0, 0
3, 0.4, 0.4, 0
4, 0, 2, 0
5, 1, 0, 0
6, 1.2, 0.2, 0
7, 0.2, 1.2, 0
8, 0, 1, 0

[PROPERTIES]
1, shellq8, 1, 0.05
[ELEMENTS]
# id, type, node1..node8, property
1, shellq8, 1, 2, 3, 4, 5, 6, 7, 8, 1

[FREEDOMCASE default]
1, x, 0
1, y, 0
1, z, 0
1, rx, 0
1, ry, 0
1, rz, 0

[LOADCASE default]
2, z, 1
