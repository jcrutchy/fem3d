# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 4, 0, 0
3, 2, 2, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, -, -

[PROPERTIES]
# id, type, material, area[, Iy, Iz, J]
1, truss, 1, 0.0015

[ELEMENTS]
# id, type, node1, node2, property[, refX, refY, refZ]
1, truss, 1, 3, 1
2, truss, 2, 3, 1

[FREEDOMCASE default]
# node, dof, value
1, x, 0
1, y, 0
1, z, 0
2, y, 0
2, z, 0
3, z, 0

[LOADCASE default]
# node, dof, value
3, y, -1000

[SOLVERPARAMS]
Tolerance=1E-9
