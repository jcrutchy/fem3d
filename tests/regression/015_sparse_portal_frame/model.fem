# FreePascal FEM Suite - native model format
[HEADER]

[NODES]
# id, x, y, z
1, 0, 0, 0
2, 0, 3, 0
3, 5, 3, 0
4, 5, 0, 0

[MATERIALS]
# id, E, nu, rho
1, 200000000000, 0.3, -

[PROPERTIES]
# id, type, material, area[, Iy, Iz, J]
1, beam, 1, 0.006, 0.00005, 0.00009, 0.00003

[ELEMENTS]
# id, type, node1, node2, property[, refX, refY, refZ]
1, beam, 1, 2, 1
2, beam, 2, 3, 1
3, beam, 3, 4, 1

[FREEDOMCASE default]
# node, dof, value
1, x, 0
1, y, 0
1, z, 0
1, rx, 0
1, ry, 0
1, rz, 0
4, x, 0
4, y, 0
4, z, 0
4, rx, 0
4, ry, 0
4, rz, 0

[LOADCASE default]
# node, dof, value
2, x, 1000

[SOLVERPARAMS]
Tolerance=1E-9
