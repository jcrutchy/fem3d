# GEO005: SURFACE 1 has normal (0,0,0) -- a plane cannot have a
# zero-length normal, so no valid plane is defined.
FEM3DGEO 1.0
UNITS length=mm
COORDSYS CARTESIAN
TOLERANCE coincidence=0.001 edge=0.001 surface=0.001 feature=0.01 angle=0.0001
SOURCE format="MANUAL" name="tutorial rectangle"

VERTEX 1 0 0 0
VERTEX 2 10 0 0
VERTEX 3 10 5 0
VERTEX 4 0 5 0

CURVE 1 LINE 0 0 0 10 0 0
CURVE 2 LINE 10 0 0 0 5 0
CURVE 3 LINE 10 5 0 -10 0 0
CURVE 4 LINE 0 5 0 0 -5 0

EDGE 1 1 2 1 0 1 +1
EDGE 2 2 3 2 0 1 +1
EDGE 3 3 4 3 0 1 +1
EDGE 4 4 1 4 0 1 +1

LOOP 1 EDGE 1 +1 EDGE 2 +1 EDGE 3 +1 EDGE 4 +1

SURFACE 1 PLANE 0 0 0 0 0 0

FACE 1 1 OUTER 1

BODY 1 FACE 1
