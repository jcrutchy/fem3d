# FreePascal FEM Suite - native model format
[HEADER]
Solver=linstatic
Units=SI (N, m, Pa, rad)

[NODES]
# id, x, y, z -- a one-storey 5 m x 4 m x 3.5 m braced frame
1, 0, 0, 0
2, 5, 0, 0
3, 5, 4, 0
4, 0, 4, 0
5, 0, 0, 3.5
6, 5, 0, 3.5
7, 5, 4, 3.5
8, 0, 4, 3.5

[MATERIALS]
# id, E, nu, rho
1, 200000000000, 0.3, -

[PROPERTIES]
# id, type, material, area, Iy, Iz, J, Cy, Cz, Rt -- a 0.2 m x 0.4 m rectangular section (depth along local y); Cy, Cz, Rt let the solver report bending and torsional stress
1, beam, 1, 0.08, 0.000266667, 0.00106667, 0.00047, 0.2, 0.1, 0.2
2, truss, 1, 0.0008

[ELEMENTS]
# id, type, node1, node2, property
1, beam, 1, 5, 1
2, beam, 2, 6, 1
3, beam, 3, 7, 1
4, beam, 4, 8, 1
5, beam, 5, 6, 1
6, beam, 6, 7, 1
7, beam, 7, 8, 1
8, beam, 8, 5, 1
9, truss, 1, 6, 2
10, truss, 3, 8, 2

[FREEDOMCASE default]
# all four column bases fully fixed
1, x, 0
1, y, 0
1, z, 0
1, rx, 0
1, ry, 0
1, rz, 0
2, x, 0
2, y, 0
2, z, 0
2, rx, 0
2, ry, 0
2, rz, 0
3, x, 0
3, y, 0
3, z, 0
3, rx, 0
3, ry, 0
3, rz, 0
4, x, 0
4, y, 0
4, z, 0
4, rx, 0
4, ry, 0
4, rz, 0

[LOADCASE gravity]
# node, dof, value -- roof gravity, N
5, z, -40000
6, z, -40000
7, z, -40000
8, z, -40000

[LOADCASE wind]
# lateral wind on the x = 0 face, plus a twist about the roof's centre
5, x, 25000
8, x, 25000
6, y, 8000
7, y, -8000

[COMBINATION ultimate]
Terms=gravity:1.35,wind:1.5

[SOLVERPARAMS]
Tolerance=1E-9
BeamDivisions=8
